<?xml version="1.0"?>
<ruleset name="FitnessClub">
    <description>
        Coding standard for the FitnessClub plugin — safety over bikeshedding.
        PSR-12 for layout, plus the two WordPress rule groups that prevent bugs:

          WordPress.DB.*        the no-raw-SQL gate. Any $wpdb query built from a
                                variable without ->prepare() is an ERROR here, so
                                CI fails on it. This is where an interpolated query
                                becomes SQL injection (plans/03-backend.md, D5).
          WordPress.Security.*  output escaping, input validation, nonces.

        Full WordPress-Extra is deliberately excluded — its Yoda/spacing/alignment
        rules would bury the security findings.
    </description>

    <!-- What to scan: code the plugin owns. -->
    <file>plugin</file>
    <file>api</file>
    <file>config</file>
    <file>bootstrap</file>
    <file>fitnessclub.php</file>
    <file>functions.php</file>
    <file>uninstall.php</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/ui/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <!-- Blade templates are not standard PHP; phpcs can't parse them. -->
    <exclude-pattern>*.blade.php</exclude-pattern>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="parallel" value="8"/>
    <arg value="sp"/>
    <arg name="extensions" value="php"/>

    <!-- CI gates on ERRORS. Warnings stay visible but don't fail the build. -->
    <config name="ignore_warnings_on_exit" value="1"/>

    <!-- ============================ Layout: PSR-12 ============================ -->
    <rule ref="PSR12">
        <!-- The plugin main file mixes a header comment with a require. -->
        <exclude name="PSR1.Files.SideEffects.FoundWithSymbols"/>
    </rule>

    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>

    <!-- ==================== Safety: no-raw-SQL + security ===================== -->

    <!-- ERROR on the request path — CI-blocking. -->
    <rule ref="WordPress.DB.PreparedSQL"/>
    <rule ref="WordPress.DB.PreparedSQL.NotPrepared">
        <type>error</type>
    </rule>
    <rule ref="WordPress.DB.PreparedSQL.InterpolatedNotPrepared">
        <type>error</type>
    </rule>

    <!-- Dev/CLI tooling (migrations, seeders, bin/) has inherent, reviewed dynamic
         SQL over our own constant table names; there the rule is a WARNING. -->
    <rule ref="WordPress.DB.PreparedSQL.NotPrepared">
        <type>warning</type>
        <include-pattern>*/database/*</include-pattern>
        <include-pattern>plugin/Database/*</include-pattern>
        <include-pattern>*/bin/*</include-pattern>
    </rule>
    <rule ref="WordPress.DB.PreparedSQL.InterpolatedNotPrepared">
        <type>warning</type>
        <include-pattern>*/database/*</include-pattern>
        <include-pattern>plugin/Database/*</include-pattern>
        <include-pattern>*/bin/*</include-pattern>
    </rule>

    <rule ref="WordPress.DB.PreparedSQLPlaceholders"/>

    <rule ref="WordPress.Security.EscapeOutput">
        <!--
            Exception messages are data, not output, in this plugin: services throw
            DomainException / RateLimitException, controllers turn them into WP_Error,
            and the REST layer JSON-encodes them. Nothing here ever echoes an
            exception, so the sniff's assumption (uncaught exceptions render to the
            page) does not hold, and satisfying it would mean esc_html() on strings
            that are about to be JSON-encoded — double-escaped text in the API.
            The rest of EscapeOutput stays on, including for the one place that does
            echo: the front-end shell render.
        -->
        <exclude name="WordPress.Security.EscapeOutput.ExceptionNotEscaped"/>
    </rule>
    <rule ref="WordPress.Security.ValidatedSanitizedInput"/>
    <rule ref="WordPress.Security.NonceVerification"/>

    <config name="minimum_wp_version" value="6.2"/>

    <!-- ================= Compatibility: plugin targets PHP 8.1+ =============== -->
    <config name="testVersion" value="8.1-"/>
    <rule ref="PHPCompatibilityWP"/>
</ruleset>
