{
  "name": "fitnessclub/fitnessclub",
  "type": "wordpress-plugin",
  "description": "Workout, nutrition and health tracking with trainer coaching. Built on WP Bones.",
  "keywords": [
    "wordpress",
    "fitness",
    "wpbones"
  ],
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1",
    "wpbones/wpbones": "^2.0.0",
    "wpbones/wpkirk-helpers": "~2.0"
  },
  "autoload": {
    "psr-4": {
      "FitnessClub\\": "plugin/"
    },
    "files": [
      "functions.php"
    ]
  },
  "scripts": {
    "post-autoload-dump": [
      "php -r \"copy('vendor/wpbones/wpbones/src/Console/bin/bones', 'bones');\""
    ]
  }
}
